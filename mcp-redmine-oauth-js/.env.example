REDMINE_URL=http://your-redmine-host
REDMINE_CLIENT_ID=your-redmine-client-id
REDMINE_CLIENT_SECRET=your-redmine-client-secret

# Optional scope allowlist. If omitted, all declared scopes are requested.
# REDMINE_SCOPES=view_issues view_project

MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_BASE_URL=http://localhost:8000

# Optional: if omitted, a random secret is generated at startup.
# Set this in production to keep tokens valid across restarts.
# MCP_JWT_SECRET=replace-me

MCP_JWT_TTL_SECONDS=3600

